<?xml version="1.0" encoding="utf-8"?>
<!-- Schlichtes Widget: nur der Bildschirm, darunter drei echte Schaltflaechen.
     Kein Ei, kein gezeichneter Rahmen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/plain_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/plain_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:visibility="gone"
            android:text="@string/import_hint" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/plain_a"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_plain"
            android:text="A"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Button
            android:id="@+id/plain_b"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_plain"
            android:text="B"
            android:textColor="#333333"
            android:textStyle="bold" />

        <Button
            android:id="@+id/plain_c"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_plain"
            android:text="C"
            android:textColor="#333333"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
